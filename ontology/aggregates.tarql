PREFIX rrr:  <https://data.aksw.org/regiostar/>
PREFIX rro:  <https://schema.aksw.org/regiostar/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
  ?wholeConcept
#      o:aggregates ?partConcept ;
      skos:narrowMatch ?partConcept .

  ?partConcept
#      o:isAggregatedBy ?wholeConcept ;
      skos:broadMatch ?wholeConcept .
}
# FROM <aggregates.csv#encoding=utf-8;delimiter=semicolon;header=absent>
WHERE {
  BIND(REPLACE(?whole_scheme, "^RegioStaR", "", "i") AS ?shortWholeScheme)
  BIND(REPLACE(?part_scheme, "^RegioStaR", "", "i") AS ?shortPartScheme)

  BIND(IRI(CONCAT(STR(rro:), "concept", "/", ENCODE_FOR_URI(?shortWholeScheme), "/", ENCODE_FOR_URI(?whole_code))) AS ?wholeConcept)
  BIND(IRI(CONCAT(STR(rro:), "concept", "/", ENCODE_FOR_URI(?shortPartScheme), "/", ENCODE_FOR_URI(?part_code))) AS ?partConcept)
}
