PREFIX rrr:  <https://data.aksw.org/regiostar/>
PREFIX rro:  <https://schema.aksw.org/regiostar/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>

CONSTRUCT {
  ?schemeResource
    a skos:ConceptScheme, rro:RegioStaRScheme ;
    dct:identifier ?shortSchemeCode ;
    skos:notation ?shortSchemeCode ;
    skos:prefLabel ?schemeLabelDe ;
    skos:hasTopConcept ?concept ;
    rdfs:label ?schemeLabelDe ;
    .

  ?concept
    a skos:Concept, rro:RegioStaRType ;
    dct:identifier ?identifier ;
    skos:notation ?shortConceptCode ;
    skos:prefLabel ?labelDe ;
    skos:inScheme ?schemeResource ;
    # skos:topConceptOf ?schemeResource ;
    rdfs:label ?labelDe ;
    .
}
WHERE {
  BIND(STRLANG(?label_de, "de") AS ?labelDe)
  BIND(CONCAT(?scheme, "/", ?code) AS ?identifier)

  BIND(REPLACE(?scheme, "^RegioStaR", "", "i") AS ?shortSchemeCode)
  BIND(CONCAT(ENCODE_FOR_URI(?shortSchemeCode), "/", ENCODE_FOR_URI(?code)) AS ?shortConceptCode)

  BIND(IRI(CONCAT(STR(rro:), "scheme", "/", ENCODE_FOR_URI(?shortSchemeCode))) AS ?schemeResource)
  BIND(IRI(CONCAT(STR(rro:), "concept", "/", ?shortConceptCode)) AS ?concept)

  BIND(STRLANG(?scheme, "de") AS ?schemeLabelDe)
}

