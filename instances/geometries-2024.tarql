PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dct: <http://purl.org/dc/terms/>

PREFIX rro: <https://schema.aksw.org/regiostar/>
PREFIX vgo: <https://schema.aksw.org/bkg/vg250/>

PREFIX r:   <https://data.aksw.org/bkg/vg250/>
PREFIX rrr: <https://data.aksw.org/regiostar/>

CONSTRUCT {
  ?feature
    geo:hasGeometry ?geometryRecord ; # Must avoid clash with ?geometry column from the CSV.
    .

  ?geometryRecord
    a geo:Geometry ;
    dct:isVersionOf ?baseObject ;
    rro:geofactor ?geofactorConcept ;
    rro:ags0 ?AGS_0 ;
    rro:ars0 ?ARS_0 ;
    geo:asWKT ?wkt ;
    .

  ?baseObject
    a rro:BkgObject ;
    dct:identifier ?OBJID ;
    .
}
WHERE {
  BIND("2024"^^xsd:gYear AS ?year)

  #BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?ARS_0)) AS ?feature)
  BIND(IRI(CONCAT(STR(rrr:), "regionalKey/", STR(?year), "/", ?ARS_0)) AS ?feature)

  # Year-qualified geometry IRI: the same BKG object is re-derived every year,
  # so the geometry is versioned by year (one WKT per year per object).
  BIND(IRI(CONCAT(STR(r:), STR(?year), "/geometry/", ENCODE_FOR_URI(?OBJID))) AS ?geometryRecord)

  # Timeless BKG base object: groups all yearly versions of the same object.
  BIND(IRI(CONCAT(STR(r:), "geometry/", ENCODE_FOR_URI(?OBJID))) AS ?baseObject)

  # Geofactor concept (1-4: waters/land with/without structure), described in
  # the static ontology (ontology/geofactor-labels.ttl).
  BIND(IRI(CONCAT(STR(vgo:), "geofactor/", ENCODE_FOR_URI(?GF))) AS ?geofactorConcept)

  # Map only the land part (GF=4). Water parts (GF=2, coastal units) are
  # excluded for now; they may be published as a separate dataset later.
  FILTER(?GF = "4")

  BIND(STRDT(?geometry, geo:wktLiteral) AS ?wkt)
}
