PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

PREFIX dcatde: <http://dcat-ap.de/def/dcatde/>

PREFIX idr:   <https://data.aksw.org/ags/>
PREFIX rro:   <https://schema.aksw.org/regiostar/>
PREFIX rrr:   <https://data.aksw.org/regiostar/>

PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>

CONSTRUCT {
  ?municipality
    a geo:Feature ;
    dct:identifier ?ags_0 ;
    skos:prefLabel ?municipalityLabel ;
    rro:regionalKey ?regionalKey ;
    #ex:nutsRegion ?nutsRegion ;
    sdmx-dimension:refPeriod ?year ;

    rro:regioStaR2 ?RegioStaR2_iri ;
    rro:regioStaR4 ?RegioStaR4_iri ;
    rro:regioStaR17 ?RegioStaR17_iri ;
    rro:regioStaR7 ?RegioStaR7_iri ;
    rro:regioStaR5 ?RegioStaR5_iri ;
    rro:regioStaRGem7 ?RegioStaRGem7_iri ;
    rro:regioStaRGem5 ?RegioStaRGem5_iri ;

    geo:hasGeometry ?geometryResource .

  ?geometryResource
    a geo:Geometry ;
    dct:identifier ?objid ;
    geo:asWKT ?geometryLiteral .
}
WHERE {
  BIND("2021"^^xsd:gYear AS ?year)

  # Normalize gemsRs
  BIND(SUBSTR(CONCAT("000000000000", ?gemrs_21), STRLEN(CONCAT("000000000000", ?gemrs_21)) - 11) AS ?ars_0)

  # You can derive the AGS from GEMRS_21 by keeping the first five and last three characters:
  BIND(CONCAT(SUBSTR(STR(?ars_0), 1, 5), SUBSTR(STR(?ars_0), 10, 3)) AS ?ags) 

  # BIND(IRI(CONCAT("https://example.org/id/municipality/", ?ags_0)) AS ?municipality)
  # BIND(IRI(CONCAT("https://example.org/id/municipality/", ?gemrs_21)) AS ?municipality)
  # BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?ars_0)) AS ?municipality)
  BIND(IRI(CONCAT(STR(rrr:), "regionalKey/", STR(?year), "/", ?ars_0)) AS ?municipality)

  BIND(STRLANG(?name_21, "de") AS ?municipalityLabel)
  BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?ars_0)) AS ?regionalKey)

  #BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?gemrs_21)) AS ?regionalKey)
  #BIND(IRI(CONCAT("https://data.europa.eu/nuts/code/", ?nuts)) AS ?nutsRegion)
  
  #BIND(IRI(CONCAT(STR(rrr:), "RegioStaR2/", ?RegioStaR2)) AS ?RegioStaR2_iri)
  #BIND(IRI(CONCAT(STR(rrr:), "RegioStaR4/", ?RegioStaR4)) AS ?RegioStaR4_iri)
  #BIND(IRI(CONCAT(STR(rrr:), "RegioStaR5/", ?RegioStaR5)) AS ?RegioStaR5_iri)
  #BIND(IRI(CONCAT(STR(rrr:), "RegioStaR7/", ?RegioStaR7)) AS ?RegioStaR7_iri)
  #BIND(IRI(CONCAT(STR(rrr:), "RegioStaR17/", ?RegioStaR17)) AS ?RegioStaR17_iri)

  BIND(IRI(CONCAT(STR(rrr:), "concept/2/", ?RegioStaR2)) AS ?RegioStaR2_iri)
  BIND(IRI(CONCAT(STR(rrr:), "concept/4/", ?RegioStaR4)) AS ?RegioStaR4_iri)
  BIND(IRI(CONCAT(STR(rrr:), "concept/5/", ?RegioStaR5)) AS ?RegioStaR5_iri)
  BIND(IRI(CONCAT(STR(rrr:), "concept/7/", ?RegioStaR7)) AS ?RegioStaR7_iri)
  BIND(IRI(CONCAT(STR(rrr:), "concept/17/", ?RegioStaR17)) AS ?RegioStaR17_iri)

  BIND(IRI(CONCAT(STR(rrr:), "concept/gem7/", ?RegioStaRGem7)) AS ?RegioStaRGem7_iri)
  BIND(IRI(CONCAT(STR(rrr:), "concept/gem5/", ?RegioStaRGem5)) AS ?RegioStaRGem5_iri)

  # BIND(IRI(CONCAT(STR(rrr:), "geometry/", ENCODE_FOR_URI(?objid))) AS ?geometryResource)

  # Adjust the CRS URI to match the shapefile, or reproject with ogr2ogr.
  # BIND(STRDT(CONCAT("<http://www.opengis.net/def/crs/EPSG/0/25832> ", ?geometry), geo:wktLiteral) AS ?geometryLiteral)
}

